{
  "name": "timur-industries-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Timur Industries Calculator for the web, Windows, Android, and iOS.",
  "author": "Timur Industries",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:web": "node scripts/copy-web-assets.cjs",
    "sync:android": "npm run build:web && cap sync android",
    "sync:ios": "npm run build:web && cap sync ios",
    "build:android": "npm run sync:android && cap build android",
    "build:ios": "npm run sync:ios && cap build ios",
    "open:android": "npm run sync:android && cap open android",
    "open:ios": "npm run sync:ios && cap open ios",
    "dist:windows": "electron-builder --win nsis portable --x64",
    "dist:windows:installer": "electron-builder --win nsis --x64",
    "dist:windows:portable": "electron-builder --win portable --x64",
    "generate:native:assets": "npx @capacitor/assets generate --android --ios --iconBackgroundColor #070d18 --splashBackgroundColor #070d18"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.timurindustries.calculator",
    "productName": "Timur Industries Calculator",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "css/**/*",
      "js/**/*",
      "icons/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "icons/timur-industries-calculator.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Timur Industries Calculator"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
